{
  "openapi": "3.0.0",
  "info": {
    "title": "Your API",
    "version": "1.0.0",
    "description": "API documentation"
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "servers": [
    {
      "url": "https://adjusterassist-backend.onrender.com",
      "description": "Production server"
    },
    {
      "url": "http://localhost:4000",
      "description": "Local server"
    }
  ],
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "summary": "Login user",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "admin@admin.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "AdminPass@123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/v1/auth/signup": {
      "post": {
        "summary": "Register new user",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "email",
                  "password",
                  "role"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "John Doe"
                  },
                  "email": {
                    "type": "string",
                    "example": "john@example.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "password123"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "ca",
                      "pa"
                    ],
                    "example": "ca",
                    "description": "User role (ca = Chartered Accountant, pa = Public Adjuster)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully"
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },
    "/api/v1/auth/forgot-password": {
      "post": {
        "summary": "Send password reset link",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "user@example.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reset link sent"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/api/v1/auth/reset-password": {
      "post": {
        "summary": "Reset user password using OTP",
        "description": "Updates the user's password after verifying the email and the 6-digit OTP code.",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "otp",
                  "newPassword"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "adjuster@example.com",
                    "description": "The email address of the account being reset"
                  },
                  "otp": {
                    "type": "string",
                    "example": "326301",
                    "description": "The 6-digit verification code sent via email"
                  },
                  "newPassword": {
                    "type": "string",
                    "format": "password",
                    "example": "SecurePass2026!",
                    "description": "The new password for the account"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password reset successful. OTP has been invalidated."
          },
          "400": {
            "description": "Invalid or expired OTP code"
          },
          "403": {
            "description": "Security violation: Invalid reset session"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/api/v1/user/profile": {
      "get": {
        "summary": "Get logged-in user profile",
        "tags": [
          "User"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "User profile fetched successfully"
          },
          "401": {
            "description": "Unauthorized (invalid or missing token)"
          }
        }
      }
    },
    "/api/v1/user/all": {
      "get": {
        "summary": "Get all users (Admin only)",
        "tags": [
          "Admin"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of all users"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden (admin access required)"
          }
        }
      }
    },
    "/api/v1/subscriptions/my-plan": {
      "get": {
        "summary": "Get current subscription plan",
        "tags": [
          "Subscriptions"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current plan fetched"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/subscriptions/upgrade": {
      "post": {
        "summary": "Upgrade subscription plan",
        "tags": [
          "Subscriptions"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "planType"
                ],
                "properties": {
                  "planType": {
                    "type": "string",
                    "example": "enterprise"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Plan upgraded successfully"
          },
          "400": {
            "description": "Invalid plan type"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/files/new": {
      "post": {
        "summary": "Create new workspace (File)",
        "description": "Initializes a claim workspace with mandatory insurance carrier metadata.",
        "tags": [
          "Files"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "claim_number",
                  "client_name",
                  "address",
                  "date_of_loss",
                  "reported_date",
                  "loss_type",
                  "jurisdiction",
                  "line_of_business",
                  "claim_stage"
                ],
                "properties": {
                  "claim_number": {
                    "type": "string",
                    "example": "CLM-2026-0987"
                  },
                  "client_name": {
                    "type": "string",
                    "example": "James Helton"
                  },
                  "address": {
                    "type": "string",
                    "example": "123 Maple St, Hartford, CT"
                  },
                  "policy_form": {
                    "type": "string",
                    "example": "HO-3"
                  },
                  "date_of_loss": {
                    "type": "string",
                    "format": "date",
                    "example": "2026-01-28"
                  },
                  "reported_date": {
                    "type": "string",
                    "format": "date",
                    "example": "2026-01-29"
                  },
                  "loss_type": {
                    "type": "string",
                    "example": "water"
                  },
                  "jurisdiction": {
                    "type": "string",
                    "example": "CT"
                  },
                  "line_of_business": {
                    "type": "string",
                    "example": "homeowners"
                  },
                  "claim_stage": {
                    "type": "string",
                    "example": "mitigation_review"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Workspace created successfully"
          },
          "400": {
            "description": "Validation error or Duplicate Claim Number"
          },
          "401": {
            "description": "Unauthorized - Valid JWT required"
          }
        }
      }
    },
    "/api/v1/files/my-files": {
      "get": {
        "summary": "Get all workspaces for current adjuster",
        "tags": [
          "Files"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Files fetched successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "files": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/files/{fileId}/drafts": {
      "get": {
        "summary": "Get all AI-generated drafts for a specific file",
        "tags": [
          "Files"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "fileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Drafts history retrieved"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Workspace not found"
          }
        }
      }
    },
    "/api/v1/drafts/generate-test": {
      "post": {
        "summary": "Generate test draft",
        "tags": [
          "Drafts"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "type",
                  "fileId"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "example": "email"
                  },
                  "fileId": {
                    "type": "integer",
                    "example": 2
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft generated successfully"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/drafts/generate": {
      "post": {
        "summary": "Generate AI draft",
        "tags": [
          "Drafts"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "fileId",
                  "type",
                  "userInput",
                  "shouldSave"
                ],
                "properties": {
                  "fileId": {
                    "type": "integer",
                    "example": 1
                  },
                  "type": {
                    "type": "string",
                    "example": "email"
                  },
                  "userInput": {
                    "type": "string",
                    "example": "The carrier is delaying payment..."
                  },
                  "task_type": {
                    "type": "string",
                    "example": "claim_note_drafting"
                  }
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Draft generated successfully"
            },
            "400": {
              "description": "Bad request"
            },
            "401": {
              "description": "Unauthorized"
            }
          }
        }
      }
    },
    "/api/v1/drafts/save": {
      "post": {
        "summary": "Save a draft",
        "tags": [
          "Drafts"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "fileId",
                  "type",
                  "content"
                ],
                "properties": {
                  "fileId": {
                    "type": "integer",
                    "example": 1
                  },
                  "type": {
                    "type": "string",
                    "example": "email"
                  },
                  "content": {
                    "type": "string",
                    "example": "Draft content..."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Draft saved"
          }
        }
      }
    },
    "/api/v1/drafts/recent": {
      "get": {
        "summary": "Get recent drafts",
        "tags": [
          "Drafts"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/v1/drafts/history": {
      "get": {
        "summary": "Get all draft history",
        "tags": [
          "Drafts"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/v1/drafts/delete/{draftId}": {
      "delete": {
        "summary": "Delete a draft by ID",
        "tags": [
          "Drafts"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "draftId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted"
          }
        }
      }
    },
    "/api/v1/files/update/{fileId}": {
      "put": {
        "summary": "Update workspace details",
        "description": "Updates any field for a specific claim workspace. All carrier-specific fields are supported.",
        "tags": [
          "Files"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "fileId",
            "in": "path",
            "required": true,
            "description": "The unique ID of the claim file",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "claim_number": {
                    "type": "string"
                  },
                  "client_name": {
                    "type": "string"
                  },
                  "address": {
                    "type": "string"
                  },
                  "policy_form": {
                    "type": "string"
                  },
                  "date_of_loss": {
                    "type": "string",
                    "format": "date"
                  },
                  "reported_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "loss_type": {
                    "type": "string"
                  },
                  "jurisdiction": {
                    "type": "string"
                  },
                  "line_of_business": {
                    "type": "string"
                  },
                  "claim_stage": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "active",
                      "archived"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Workspace updated successfully",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Workspace updated successfully",
                  "file": {
                    "id": 1,
                    "claim_number": "CLM-001",
                    "status": "active"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Unauthorized to update this workspace"
          },
          "404": {
            "description": "Workspace not found"
          }
        }
      }
    },
    "/api/v1/files/delete/{fileId}": {
      "delete": {
        "summary": "Delete a workspace",
        "description": "Permanently removes a workspace and all associated data.",
        "tags": [
          "Files"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "fileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Workspace and all associated drafts deleted successfully",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Workspace deleted successfully"
                }
              }
            }
          },
          "403": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Workspace not found"
          }
        }
      }
    },
    "/api/v1/drafts/update/{draftId}": {
      "put": {
        "summary": "Update an existing AI draft",
        "description": "Allows the user to edit the content or type of a previously saved draft. Only the owner of the draft can perform this action.",
        "tags": [
          "Drafts"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "draftId",
            "in": "path",
            "required": true,
            "description": "The unique numeric ID of the draft to update",
            "schema": {
              "type": "integer",
              "example": 101
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "draft_type": {
                    "type": "string",
                    "example": "claim_note_drafting",
                    "description": "The category of the claim task"
                  },
                  "content": {
                    "type": "string",
                    "example": "Updated factual observations regarding the roof damage...",
                    "description": "The edited text content of the draft"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft updated successfully",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Draft updated successfully",
                  "data": {
                    "id": 101,
                    "content": "Updated content...",
                    "draft_type": "claim_note_drafting",
                    "updated_at": "2026-03-28T11:00:00Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Missing or invalid token"
          },
          "403": {
            "description": "Forbidden - You do not own this draft"
          },
          "404": {
            "description": "Draft not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/v1/notifications/test-send": {
      "post": {
        "summary": "Send a test push notification",
        "description": "Fetches the current user's Expo Push Token and sends a test notification to their device.",
        "tags": [
          "Notifications"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Notification sent or queued successfully",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Notification sent (or queued) successfully",
                  "tickets": [
                    {
                      "status": "ok",
                      "id": "xxxx-xxxx-xxxx-xxxx"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "No push token found for user",
            "content": {
              "application/json": {
                "example": {
                  "error": "No push token saved for this user"
                }
              }
            }
          },
          "500": {
            "description": "Server error or Supabase issue",
            "content": {
              "application/json": {
                "example": {
                  "error": "Failed to fetch user token"
                }
              }
            }
          }
        }
      }
    }
  }
}