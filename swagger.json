{
  "openapi": "3.0.0",
  "info": {
    "title": "Your API",
    "version": "1.0.0",
    "description": "API documentation"
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "servers": [
    {
      "url": "https://adjusterassistbe.onrender.com",
      "description": "Production server"
    },
    {
      "url": "http://localhost:5000",
      "description": "Local server"
    }
  ],
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "summary": "Login user",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "admin@admin.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "AdminPass"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/v1/auth/signup": {
      "post": {
        "summary": "Register new user",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "email",
                  "password",
                  "role"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "John Doe"
                  },
                  "email": {
                    "type": "string",
                    "example": "john@example.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "password123"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "ca",
                      "pa"
                    ],
                    "example": "ca",
                    "description": "User role (ca = Chartered Accountant, pa = Public Adjuster)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully"
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },
    "/api/v1/auth/forgot-password": {
      "post": {
        "summary": "Send password reset link",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "user@example.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reset link sent"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/api/v1/auth/reset-password": {
      "post": {
        "summary": "Reset user password",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "token",
                  "newPassword"
                ],
                "properties": {
                  "token": {
                    "type": "string",
                    "example": "reset-token"
                  },
                  "newPassword": {
                    "type": "string",
                    "example": "newPassword123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password reset successful"
          },
          "400": {
            "description": "Invalid or expired token"
          }
        }
      }
    },
    "/api/v1/user/profile": {
      "get": {
        "summary": "Get logged-in user profile",
        "tags": [
          "User"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "User profile fetched successfully"
          },
          "401": {
            "description": "Unauthorized (invalid or missing token)"
          }
        }
      }
    },
    "/api/v1/user/all": {
      "get": {
        "summary": "Get all users (Admin only)",
        "tags": [
          "Admin"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of all users"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden (admin access required)"
          }
        }
      }
    },
    "/api/v1/subscriptions/my-plan": {
      "get": {
        "summary": "Get current subscription plan",
        "tags": [
          "Subscriptions"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current plan fetched"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/subscriptions/upgrade": {
      "post": {
        "summary": "Upgrade subscription plan",
        "tags": [
          "Subscriptions"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "planType"
                ],
                "properties": {
                  "planType": {
                    "type": "string",
                    "example": "enterprise"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Plan upgraded successfully"
          },
          "400": {
            "description": "Invalid plan type"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/files/new": {
      "post": {
        "summary": "Create new file",
        "tags": [
          "Files"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "claim_number",
                  "client_name",
                  "policy_number"
                ],
                "properties": {
                  "claim_number": {
                    "type": "string",
                    "example": "CLM-2026-001"
                  },
                  "client_name": {
                    "type": "string",
                    "example": "John Smith"
                  },
                  "policy_number": {
                    "type": "string",
                    "example": "POL-99"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "File created successfully"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/files/my-files": {
      "get": {
        "summary": "Get user files",
        "tags": [
          "Files"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Files fetched successfully"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/files/{fileId}/drafts": {
      "get": {
        "summary": "Get drafts for a file",
        "tags": [
          "Files"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "fileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Drafts fetched successfully"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "File not found"
          }
        }
      }
    },
    "/api/v1/drafts/generate-test": {
      "post": {
        "summary": "Generate test draft",
        "tags": [
          "Drafts"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "type",
                  "fileId"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "example": "email"
                  },
                  "fileId": {
                    "type": "integer",
                    "example": 2
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft generated successfully"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/drafts/generate": {
      "post": {
        "summary": "Generate AI draft",
        "tags": [
          "Drafts"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "fileId",
                  "type",
                  "userInput",
                  "shouldSave"
                ],
                "properties": {
                  "fileId": {
                    "type": "integer",
                    "example": 1
                  },
                  "type": {
                    "type": "string",
                    "example": "email"
                  },
                  "userInput": {
                    "type": "string",
                    "example": "The carrier is delaying payment..."
                  },
                  "shouldSave": {
                    "type": "boolean",
                    "example": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft generated successfully"
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/drafts/save": {
      "post": {
        "summary": "Save a draft",
        "tags": [
          "Drafts"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "fileId",
                  "type",
                  "content"
                ],
                "properties": {
                  "fileId": {
                    "type": "integer",
                    "example": 1
                  },
                  "type": {
                    "type": "string",
                    "example": "email"
                  },
                  "content": {
                    "type": "string",
                    "example": "This is the draft content..."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Draft saved successfully"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/drafts/recent": {
      "get": {
        "summary": "Get recent drafts of user",
        "tags": [
          "Drafts"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Recent drafts fetched successfully"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/drafts/history": {
      "get": {
        "summary": "Get all drafts history of user",
        "tags": [
          "Drafts"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Draft history fetched successfully"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/drafts/delete/{draftId}": {
      "delete": {
        "tags": [
          "Drafts"
        ],
        "summary": "Delete a draft by ID",
        "description": "Deletes a specific draft. Requires authentication.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "draftId",
            "in": "path",
            "required": true,
            "description": "The numeric ID of the draft to delete",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Draft deleted successfully"
          },
          "401": {
            "description": "Unauthorized - token missing or invalid"
          },
          "404": {
            "description": "Draft not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/v1/files/update/{fileId}": {
      "put": {
        "tags": [
          "Files"
        ],
        "summary": "Update workspace details",
        "description": "Updates the metadata for a specific workspace. Only the owner can perform this action.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "fileId",
            "in": "path",
            "required": true,
            "description": "The unique ID of the workspace to update",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "client_name": {
                    "type": "string",
                    "example": "John Doe"
                  },
                  "claim_number": {
                    "type": "string",
                    "example": "CLM-12345"
                  },
                  "policy_number": {
                    "type": "string",
                    "example": "POL-9988"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "active",
                      "archived"
                    ],
                    "default": "active"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Workspace updated successfully"
          },
          "401": {
            "description": "Unauthorized - Missing or invalid token"
          },
          "403": {
            "description": "Forbidden - You do not own this workspace"
          },
          "404": {
            "description": "Workspace not found"
          }
        }
      }
    },
    "/api/v1/files/delete/{fileId}": {
      "delete": {
        "tags": [
          "Files"
        ],
        "summary": "Delete a workspace and its drafts",
        "description": "Permanently deletes the workspace. WARNING: This will also delete all associated AI drafts due to database cascading rules.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "fileId",
            "in": "path",
            "required": true,
            "description": "The unique ID of the workspace to delete",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Workspace and all associated drafts deleted"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - Ownership mismatch"
          },
          "404": {
            "description": "Workspace not found"
          }
        }
      }
    }
  }
}
